// SPDX-License-Identifier: GPL-3.0-only
// Explorer's file details for onslaught-ce.exe. build.py supplies the numeric core and exact CE version label.
// This is independent of bea.exe's retail 1.0.0.0 resource in version.rc and both programs' UTF-8 manifest.
#include <winver.h>
#include "launcher-version.h"

1 VERSIONINFO
FILEVERSION CE_VERSION_WORDS
PRODUCTVERSION CE_VERSION_WORDS
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Onslaught CE contributors\0"
            VALUE "FileDescription", "Onslaught CE launcher\0"
            VALUE "FileVersion", CE_VERSION_TEXT "\0"
            VALUE "InternalName", "onslaught-ce\0"
            VALUE "OriginalFilename", "onslaught-ce.exe\0"
            VALUE "ProductName", "Onslaught CE\0"
            VALUE "ProductVersion", CE_VERSION_TEXT "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

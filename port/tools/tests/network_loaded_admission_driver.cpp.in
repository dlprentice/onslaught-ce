enum {GAME_STATE_NOT_RUNNING,GAME_STATE_PRE_RUNNING,GAME_STATE_PANNING,GAME_STATE_PLAYING,GAME_STATE_LEVEL_LOST};
enum {kCooperativeMultiplayer=1,kVersusMultiplayer=2};
struct CThing {virtual ~CThing(){};}; struct IController {virtual ~IController(){};};
template<class T> struct SPtrSet {std::vector<T*> values;int expected=-1;int owner_cursor=71;int Size(){return expected<0?(int)values.size():expected;}};
template<class T> struct ListIterator {SPtrSet<T>*s;size_t i=0;ListIterator(SPtrSet<T>*p):s(p){} T*First(){i=0;return i<s->values.size()?s->values[i]:nullptr;}T*Next(){++i;return i<s->values.size()?s->values[i]:nullptr;}};
struct CBattleEngineData {char*mConfigurationName;};
class UBattleEngineDataManager {friend class CENetworkLoadedAdmission;friend struct Fixture;static SPtrSet<CBattleEngineData>sData;public:static CBattleEngineData*GetConfiguration(int i){if(i<0)i=0;return (unsigned)i<sData.values.size()?sData.values[i]:nullptr;} static CBattleEngineData*GetConfiguration(char*n){for(auto*p:sData.values)if(!strcmp(p->mConfigurationName,n))return p;return nullptr;}};
SPtrSet<CBattleEngineData>UBattleEngineDataManager::sData;
const int kMaxConfigurations=20;
class UBattleEngineConfigurations {friend struct Fixture;static int sConfigurations;static char*sConfigurationName[20];public:static int CountConfigurations(){return sConfigurations;} static CBattleEngineData*GetConfiguration(int);
/* RAW_ACCESSOR */
};
int UBattleEngineConfigurations::sConfigurations;char*UBattleEngineConfigurations::sConfigurationName[20];
/* NATIVE_FALLBACK */
struct CPlayer;
struct CBattleEngine:CThing {CPlayer*owner=nullptr;int mConfigurationId=0;CBattleEngineData*mConfiguration=nullptr;int mInfinateEnergy=0,vulnerable=1;CPlayer*GetPlayer(){return owner;}int GetVulnerable(){return vulnerable;}};
struct CPlayer:IController {int number=0,god=0;CBattleEngine*engine=nullptr;int GetNumber(){return number;}CBattleEngine*GetBattleEngine(){return engine;}int IsGod(){return god;}};
struct CController {virtual~CController(){}int pad=0,mPlaying=0,mRecording=0;IController*target=nullptr;int GetPadNumber(){return pad;}IController*GetToControl(){return target;}};
struct CPCController:CController{};struct OtherController:CPCController{};
struct CBattleEngineInitThing {int mConfigurationId=0;};
struct CStart:CThing {int number=0;CBattleEngine*engine=nullptr;CBattleEngineInitThing mInit;unsigned GetPlayerNumber(){return number;}CBattleEngine*GetPlayerObject(){return engine;}};
struct SFrontEndSettings {int mInvertSides=0,mPlayer1Configuration=0,mPlayer2Configuration=0;};
struct CGame {int level=852,mCurrentlyRunningLevel=852,n=2,phase=GAME_STATE_PRE_RUNNING,mQuit=0,mAdvanceFrame=0,mFixedFrameRate=0,mAllowedAutoAim=1,mFullscreenMultiplayer=0,mSupervisorMode=1;float mFrameLength=.05f;SFrontEndSettings settings;CPlayer*players[2]{};CController*mController[2]{};bool freecam[2]{};int GetCurrentLevel(){return level;}int GetNPlayers(){return n;}int GetGameState(){return phase;}CPlayer*GetPlayer(int i){return players[i];}bool IsFreeCameraOn(int i){return freecam[i];}SFrontEndSettings*GetFrontEndSettings(){return &settings;}BOOL IsMultiplayer();}GAME;
/* NATIVE_GAME_MP */
struct CWorld {int mType=2;SPtrSet<CStart>starts;SPtrSet<CThing>things;BOOL IsMultiplayer();SPtrSet<CStart>&GetStartNB(){return starts;}SPtrSet<CThing>&GetThingNB(){return things;}}WORLD;
/* NATIVE_WORLD_MP */
struct CCareer {int god[2]{};int GetIsGod(int i){return god[i];}}CAREER;
struct CCLIParams {
#define FLAG(x) int x=0;
/* CLI_FLAGS */
#undef FLAG
}CLIPARAMS;
SINT PLAYABLE_DEMO=0,performing_stress_test=0;bool E3_BUILD=false,gPortCheatNameOnly=false;char gAllCheatsEnabled=0;
struct CFEPSaveGame {WCHAR mSaveGameName[256]{};BOOL IsCheatActive(int);};struct CFrontEnd {CFEPSaveGame mFEPSaveGame;}FRONTEND;
unsigned native_queries=0,cheat_on_calls=0,unexpected_io=0,cached_calls=0;int cache_status=1;unsigned cache_mask=0;
char*FromWCHAR(const WCHAR*s){static char text[257];unsigned i=0;for(;i<256&&s[i];++i)text[i]=(char)s[i];text[i]=0;return text;}
/* NATIVE_CHEAT_TABLE */
extern "C" int CE_CheatOn(int i){++cheat_on_calls;if(cache_status!=1){++unexpected_io;return 0;}return (cache_mask>>i)&1;}
/* NATIVE_CHEAT_QUERY */
int automation=1,window_automation=1,update_automation=1;int clock_status=1;
extern "C" int CE_CheatCachedStatus(unsigned*out){++cached_calls;if(cache_status!=1)return 0;*out=cache_mask;return 1;}
extern "C" int CE_NetAutomationIdle(){return automation;}
extern "C" int CE_NetWindowAutomationIdle(){return window_automation;}
extern "C" int CE_NetUpdateAutomationIdle(){return update_automation;}
extern "C" int CE_NetClockOrdinary(){return clock_status;}
extern "C" bool PortTypeInfoEqual(const std::type_info&a,const std::type_info&b)noexcept{return a==b;}
/* ACTUAL_VALIDATOR */
unsigned checks=0;
void check(bool value,const char*why){++checks;if(!value){fprintf(stderr,"FAIL %s: %s\n",why,CE_NetLoadedAdmissionError());exit(2);}}

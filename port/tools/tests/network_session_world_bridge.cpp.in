// Test-only full-frame/header/platform boundaries around source-exact World lifecycle/native Init functions.
// The real full-world serializer/actor ABI is not modeled as proven by this bridge.
static CBattleEngine fixture_owners[2];
static CExplosionData fixture_pulse;
static CParticleDescriptor fixture_particle{1};
static CEffect fixture_sound;
static SPtrSet<CExplosionData> fixture_registry;
static CExplosion *fixture_spawn;
static unsigned fixture_full_applies;
static CE_WorldFrame Frame(uint32_t sequence,uint32_t tick) {
    CE_WorldFrame f{};f.epoch=config.epoch;f.sequence=sequence;f.tick=tick;f.level=852;f.count=2;
    f.lifecycle_baseline=life_enabled?life_baseline:0;f.lifecycle_watermark=life_enabled?life_generated:0;
    for(unsigned i=0;i<2;++i) {
        Entity&e=f.entities[i];e.core.id=36+i;e.core.kind=ENGINE_THING;e.core.initial_number=16+i;e.core.player=i+1;
        e.core.type=fixture_owners[i].mThingType;e.core.flags=TF_IN_MAP_WHO;
        Name(e.core.class_name,"CBattleEngine");Name(e.core.mesh,"local-engine.msh");Name(e.engine.cockpit.mesh,"local-cockpit.msh");
        e.engine.cockpit.schema=123+i;for(unsigned j=0;j<9;++j)e.core.orientation.v[j]=e.core.old_orientation.v[j]=(j%4==0?1.f:0.f);
    }
    return f;
}
extern "C" int CE_WorldBegin(const CE_WorldConfig *c) {
    if(!c)return 0;reset(c->role,true);config=*c;EVENT_MANAGER.frame=60;applied_tick=applied_sequence=0;published_frame=published_tick=captured_sequence=captured_tick=0;
    Bind(&fixture_owners[0],36,16);Bind(&fixture_owners[1],37,17);next_id=38;fixture_full_applies=0;fixture_spawn=nullptr;
    fixture_pulse={};fixture_pulse.mName=(char*)"Mech Pulse Hit Large";fixture_pulse.mRadius=1;fixture_pulse.mDamage=4;fixture_pulse.mLight=0;
    fixture_pulse.mParticleA=fixture_pulse.mParticleB=fixture_pulse.mParticleC=fixture_pulse.mParticleD=&fixture_particle;fixture_pulse.mSoundA=&fixture_sound;
    fixture_registry.v.clear();fixture_registry.v.push_back(&fixture_pulse);UPhysicsManager::mExplosions=&fixture_registry;return 1;
}
extern "C" void CE_WorldEnd() {
    while(!WORLD.things.v.empty())WORLD.things.v.front()->Shutdown();binding_count=0;LifeReset();active=false;fixture_spawn=nullptr;
}
extern "C" int CE_WorldActive(){return active;}
extern "C" const char *CE_WorldError(){return error_text;}
extern "C" CE_WorldFrame *CE_WorldFrameCreate(){return new CE_WorldFrame{};}
extern "C" void CE_WorldFrameDestroy(CE_WorldFrame *f){delete f;}
extern "C" int CE_WorldFrameInfo(const CE_WorldFrame*f,CE_WorldInfo*out){
    if(!f||!out)return 0;*out={};out->epoch=f->epoch;out->level=f->level;out->tick=f->tick;out->frame_sequence=f->sequence;out->phase=f->phase;
    out->lifecycle_baseline=f->lifecycle_baseline;out->lifecycle_watermark=f->lifecycle_watermark;return 1;
}
extern "C" int CE_WorldCapture(CE_WorldFrame*f){if(!f)return 0;*f=Frame(++captured_sequence,EVENT_MANAGER.frame);captured_tick=f->tick;return 1;}
// A deliberately small full-state boundary; actual WriteCore bytes and exact Start byte-proof remain genuine.
extern "C" int CE_WorldEncode(const CE_WorldFrame*f,uint8_t*out,uint32_t cap,uint32_t*size){
    if(!f||!out||!size)return 0;CE_NetWriter w;CE_NetWriterInit(&w,out,cap);
    CE_NetWriteU32(&w,f->epoch);CE_NetWriteU32(&w,f->level);CE_NetWriteU32(&w,f->tick);CE_NetWriteU32(&w,f->sequence);
    CE_NetWriteU32(&w,f->count);CE_NetWriteU32(&w,f->lifecycle_baseline);CE_NetWriteU32(&w,f->lifecycle_watermark);CE_NetWriteU32(&w,f->phase);
    for(unsigned i=0;i<f->count;++i)WriteCore(&w,f->entities[i].core);CE_NetWriteU32(&w,f->score);*size=w.size;return !w.error;
}
extern "C" int CE_WorldDecode(CE_WorldFrame*f,const uint8_t*bytes,uint32_t size){
    if(!f)return 0;*f=Frame(1,60);CE_NetReader r;CE_NetReaderInit(&r,bytes,size);
    f->epoch=CE_NetReadU32(&r);f->level=CE_NetReadU32(&r);f->tick=CE_NetReadU32(&r);f->sequence=CE_NetReadU32(&r);
    f->count=CE_NetReadU32(&r);f->lifecycle_baseline=CE_NetReadU32(&r);f->lifecycle_watermark=CE_NetReadU32(&r);f->phase=CE_NetReadU32(&r);
    if(f->count>kEntities)return 0;for(unsigned i=0;i<f->count;++i)ReadCore(&r,f->entities[i].core);f->score=CE_NetReadU32(&r);return CE_NetReadDone(&r);
}
extern "C" int CE_WorldAppliedBirths(CE_WorldBirthAck*){return 0;}
extern "C" int CE_WorldAcknowledgeBirths(uint32_t,uint32_t,uint32_t){return -1;}
extern "C" int CE_WorldSampleInput(CE_WorldInput*){return 0;}
extern "C" int CE_WorldEncodeInput(const CE_WorldInput*,uint8_t*,uint32_t,uint32_t*){return 0;}
extern "C" int CE_WorldDecodeInput(CE_WorldInput*,const uint8_t*,uint32_t){return 0;}
extern "C" int CE_WorldInputSent(uint32_t){return -1;}
extern "C" int CE_WorldQueueRemoteInput(const CE_WorldInput*){return -1;}
extern "C" int CE_WorldSetInputSuspended(uint32_t){return 1;}
extern "C" void CE_WorldRebaseLocalSampler(){}
extern "C" void FixtureTick(uint32_t tick){EVENT_MANAGER.frame=tick;}
extern "C" int FixtureSpawn(){
    fixture_spawn=UPhysicsManager::SpawnExplosion(0);if(!fixture_spawn)return 0;
    CExplosionInitThing init;init.mBehaviour=&fixture_pulse;init.mOriginator=&fixture_owners[1];init.mPos={1,2,-1};init.mImportant=TRUE;
    fixture_spawn->Init(&init);return !life_failed&&life_count==1;
}
extern "C" void FixtureDespawn(){if(fixture_spawn){fixture_spawn->Shutdown();fixture_spawn=nullptr;}}
extern "C" void FixtureFailFactory(int value){heap.free=value?0:204800;}
extern "C" int FixtureReadinessProbe(unsigned which){
    CE_WorldFrame f=Frame(applied_sequence+1,life_baseline_tick);f.lifecycle_watermark=life_applied-1;
    switch(which){case 1:f.valid=false;break;case 2:f.tick=life_baseline_tick-1;break;
    case 3:++f.lifecycle_baseline;break;case 4:f.lifecycle_watermark=life_applied;break;case 5:++f.epoch;break;default:break;}
    return CE_WorldFrameReadiness(&f);
}
extern "C" uint32_t FixtureRead(unsigned field){
    switch(field){case 0:return life_applied;case 1:return life_count;case 2:return life_ack;case 3:return allocations;
    case 4:return fx_calls;case 5:return applied_tick;case 6:return poisoned;case 7:return life_live_count;case 8:return life_enabled;case 9:return life_published;case 10:return EVENT_MANAGER.frame;default:return UINT32_MAX;}
}

#include <cstring>
#include <cstdint>
#include <initializer_list>
#include <atomic>
using Uint64=uint64_t;const int SDL_EVENT_MOUSE_MOTION=1,SDL_EVENT_MOUSE_BUTTON_DOWN=2,SDL_EVENT_MOUSE_BUTTON_UP=3,
 SDL_EVENT_WINDOW_RESTORED=4,SDL_EVENT_WINDOW_FOCUS_GAINED=5,SDL_BUTTON_LEFT=1;
struct SDL_Event {int type=0;struct{float x=0,y=0;}motion;struct{int button=0;bool down=false;float x=0,y=0;}button;};
unsigned getenv_calls=0,events=0,clock_reads=0,file_opens=0,delays=0;bool fail_open=false;
// The ordinary Pump prefix also reports input activity. This admission fixture models that owner
// as a counted boundary; it does not claim to exercise SDL input activity or its timing.
unsigned activity_pulses=0;
void *MainWindow(){return nullptr;} void *Sdl(void *window){return window;}
namespace PortInputActivity { void Pulse(void *){++activity_pulses;} }
const char*OwnerEnv(const char*n){++getenv_calls;return std::getenv(n);}
Uint64 SDL_GetTicks(){++clock_reads;return 100000;}
// The extracted Pump prefix now contains a fake-restore timer. Its state is zero
// in these admission controls; the window suite exercises the restore path.
Uint64 SDL_GetTicksNS(){++clock_reads;return Uint64(100000)*1000000;}
bool SDL_PushEvent(SDL_Event*){++events;return true;}
void SDL_DelayNS(Uint64){++delays;}
FILE*OwnerOpen(const char*,const char*){++file_opens;return fail_open?nullptr:reinterpret_cast<FILE*>(uintptr_t(1));}
#define PORT_LOG_PREFIX "fixture: "
#define getenv OwnerEnv
// The frame-feel measurement (feel.h) is off in this fixture: the extracted Pump prefix tests it once and has nothing to count.
#define PORT_FEEL_ON() 0
void PortFeelPump() {}

/* REPLAY_PACING */
}
#undef getenv
unsigned checks=0;void check(bool b,const char*why){++checks;if(!b){fprintf(stderr,"FAIL %s\n",why);exit(2);}}
void Clear(){unsetenv("BEA_PORT_FAKE_CLICK");unsetenv("BEA_PORT_FAKE_KEYS");unsetenv("BEA_PORT_UPDATE_DUMP");unsetenv("BEA_PORT_UPDATE_DUMP_FROM");unsetenv("BEA_PORT_UPDATE_DUMP_TO");unsetenv("BEA_PORT_UPDATE_DUMP_THINGS");unsetenv("BEA_PORT_REPLAY_SLEEP_US");unsetenv("BEA_PORT_CLOCK");unsetenv("BEA_PORT_CLOCK_DT");}
int main(int argc,char**argv){check(argc==2,"case");Clear();const char*c=argv[1];
 if(!strcmp(c,"clock-cold")){check(CE_NetClockOrdinary()==-1&&gMode.load()==-1&&!getenv_calls,"cold clock query never initializes");}
 else if(!strcmp(c,"clock-real")){check(Mode()==REAL&&CE_NetClockOrdinary()==1,"actual normal mode selected");const auto before=getenv_calls;setenv("BEA_PORT_CLOCK","present",1);check(CE_NetClockOrdinary()==1&&getenv_calls==before&&Mode()==REAL,"actual mode retained despite changed env");}
 else if(!strcmp(c,"clock-virtual")){setenv("BEA_PORT_CLOCK","present",1);check(Mode()==PRESENT&&CE_NetClockOrdinary()==0,"actual virtual mode refused");unsetenv("BEA_PORT_CLOCK");const auto before=getenv_calls;check(CE_NetClockOrdinary()==0&&getenv_calls==before,"virtual mode retained");}
 else if(!strcmp(c,"cold")){check(CE_NetWindowAutomationIdle()==-1&&CE_NetUpdateAutomationIdle()==-1&&CE_NetAutomationIdle()==-1,"cold unknown");check(getenv_calls==0&&!events&&!clock_reads&&!file_opens&&!delays,"pure cold queries");}
 else if(!strcmp(c,"off-owner")){OriginalWindowOwner();OriginalUpdateOwner();const unsigned old_env=getenv_calls;check(!events&&!clock_reads&&!file_opens&&!activity_pulses,"original OFF boundaries");getenv_calls=0;CandidateWindowOwner();CandidateUpdateOwner();check(getenv_calls==old_env,"same ordinary OFF configuration reads");check(CE_NetWindowAutomationIdle()==1&&CE_NetUpdateAutomationIdle()==1,"ordinary OFF owners known idle");check(!events&&!clock_reads&&!file_opens&&activity_pulses==1,"candidate OFF calls the modeled activity boundary without events IO or clocks");}
 else if(!strcmp(c,"prepare-idle")){InitWindowAutomationConfig();InitUpdateAutomationConfig();const auto before=getenv_calls;check(CE_NetWindowAutomationIdle()==1&&CE_NetUpdateAutomationIdle()==1,"prepared idle");check(getenv_calls==before&&!events&&!clock_reads&&!file_opens,"prepare/getter no effects");}
 else if(!strcmp(c,"disabled-sticky")){InitWindowAutomationConfig();InitUpdateAutomationConfig();setenv("BEA_PORT_FAKE_KEYS","a0:1:2",1);setenv("BEA_PORT_FAKE_CLICK","0:1,2",1);setenv("BEA_PORT_UPDATE_DUMP","unopened",1);const auto before=getenv_calls;CandidateWindowOwner();CandidateUpdateOwner();check(getenv_calls==before&&!events&&!clock_reads&&!file_opens,"cached disabled choice cannot enable later");check(CE_NetWindowAutomationIdle()==1&&CE_NetUpdateAutomationIdle()==1,"disabled remains idle");}
 else if(!strcmp(c,"keys-history")){setenv("BEA_PORT_FAKE_KEYS","a0:1:2",1);InitWindowAutomationConfig();check(CE_NetWindowAutomationIdle()==0,"configured keys");gWindowFakeKeys="";unsetenv("BEA_PORT_FAKE_KEYS");check(CE_NetWindowAutomationIdle()==0,"exhausted keys history retained");}
 else if(!strcmp(c,"click-history")){setenv("BEA_PORT_FAKE_CLICK","0:1,2",1);CandidateWindowOwner();check(events==3&&clock_reads==1,"actual ordinary click prefix emits three");check(gWindowFakeState==2&&CE_NetWindowAutomationIdle()==0,"completed click history retained");}
 else if(!strcmp(c,"dump-history")){setenv("BEA_PORT_UPDATE_DUMP","unopened",1);fail_open=true;InitUpdateAutomationConfig();check(!file_opens&&CE_NetUpdateAutomationIdle()==0,"configured dump refuses before file open");CandidateUpdateOwner();check(file_opens==1&&gDumpAttempted&&!gDump,"actual failed open boundary");unsetenv("BEA_PORT_UPDATE_DUMP");check(CE_NetUpdateAutomationIdle()==0,"failed dump history retained");}
 else if(!strcmp(c,"dump-range")){setenv("BEA_PORT_UPDATE_DUMP_FROM","7",1);setenv("BEA_PORT_UPDATE_DUMP_TO","19",1);setenv("BEA_PORT_UPDATE_DUMP_THINGS","0",1);InitUpdateAutomationConfig();check(gFrom==7&&gTo==19&&!gThings&&!file_opens&&!events,"actual parse no write");check(CE_NetUpdateAutomationIdle()==1,"range options without dump inactive");}
 else if(!strcmp(c,"replay-present")){gInit=true;check(CE_NetAutomationIdle()==-1,"Init alone lacks pacing observation");ReplayPresentPacing();const auto before=getenv_calls;check(CE_NetAutomationIdle()==1&&!delays&&getenv_calls==before,"ordinary actual Present pacing idle");setenv("BEA_PORT_REPLAY_SLEEP_US","100",1);ReplayPresentPacing();check(!delays,"pacing choice retained");}
 else if(!strcmp(c,"replay-pacing")){gInit=true;setenv("BEA_PORT_REPLAY_SLEEP_US","100",1);ReplayPresentPacing();check(delays==1&&CE_NetAutomationIdle()==0,"actual pacing refuses");unsetenv("BEA_PORT_REPLAY_SLEEP_US");unsetenv("BEA_PORT_CLOCK");unsetenv("BEA_PORT_CLOCK_DT");check(CE_NetAutomationIdle()==0,"pacing history retained");}
 else if(!strcmp(c,"replay-modes")){gInit=true;gPacingObserved=true;for(bool*p:{&gActive,&gRecording,&gObjects,&gTapeCursor,&gRecordFailed,&gRecordStageOwned}){*p=true;check(CE_NetAutomationIdle()==0,"actual replay flag");*p=false;}gProbes=reinterpret_cast<FILE*>(uintptr_t(1));check(!CE_NetAutomationIdle(),"probe handle");gProbes=nullptr;gPendingCount=1;check(!CE_NetAutomationIdle(),"pending input");gPendingCount=0;gMax=1;check(!CE_NetAutomationIdle(),"configured replay close");}
 else check(false,"known case");printf("%s: %u assertions passed\n",c,checks);
}

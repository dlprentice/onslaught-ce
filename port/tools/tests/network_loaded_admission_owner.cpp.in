 bool gInit=false;FILE*gDump=nullptr;unsigned long gFrom=1,gTo=0xffffffffUL;bool gThings=true;
#define fopen OwnerOpen
/* ORIGINAL_UPDATE_PREFIX */
#undef fopen
 (void)gDump;(void)gFrom;(void)gTo;(void)gThings;
}
// Replay state is controlled storage; the query and first-Present pacing observation are actual bodies.
bool gActive=false,gRecording=false,gObjects=false,gPacingObserved=false,gTapeCursor=false,gRecordFailed=false,gRecordStageOwned=false;
long gReplaySleepUs=0;FILE*gProbes=nullptr,*gRecord=nullptr;const char*gPilot=nullptr;void*gEvents=nullptr;size_t gPendingCount=0,gCount=0;unsigned gMax=0;
/* REPLAY_IDLE */

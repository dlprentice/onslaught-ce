uint32_t ThingKind(CThing*t){return dynamic_cast<CRound*>(t)?ROUND_THING:dynamic_cast<CExplosion*>(t)?EXPLOSION_THING:dynamic_cast<CBattleEngine*>(t)?ENGINE_THING:STATIC_THING;}

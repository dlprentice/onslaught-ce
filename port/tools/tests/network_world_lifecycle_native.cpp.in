/* ADAPTER */
};
int CE_WorldReplica(){return active&&config.role==CE_WORLD_REPLICA;}
/* SPAWN_ALLOWED */
void CE_WorldExplosionBirth(CExplosion*e,CInitThing*i){++entry_calls;trace.push_back("Entry");CENetworkWorldAdapter::ExplosionBirthEntry(e,i);}
void CE_WorldExplosionReady(CExplosion*e,CInitThing*i){++ready_calls;trace.push_back("Ready");CENetworkWorldAdapter::ExplosionReady(e,i);}
void CE_WorldForget(const void*t){if(applying)return;for(unsigned i=0;i<binding_count;++i)if(bindings[i].thing==t){bindings[i]=bindings[--binding_count];return;}}
/* LIFECYCLE_WRAPPERS */
/* LIFECYCLE_CODEC */
int CE_WorldEncode(const CE_WorldFrame*f,uint8_t*out,uint32_t capacity,uint32_t*size){if(!f||!out||!size)return 0;CE_NetWriter w;CE_NetWriterInit(&w,out,capacity);CE_NetWriteBytes(&w,f->encoding,sizeof f->encoding);for(unsigned i=0;i<f->count;++i)WriteCore(&w,f->entities[i].core);CE_NetWriteU32(&w,f->score);if(w.error)return 0;*size=w.size;return 1;}
/* LIFECYCLE_API */
/* ACTUAL_NATIVE */
void CThing::Init(CInitThing*i){if(dynamic_cast<CRound*>(this)){RoundThingInit(i);return;}mPos=i->mPos;SetThingType(0);WORLD.AddThing(this);}
void CComplexThing::Init(CInitThing*i){++base_inits;trace.push_back("BaseInit");if(auto*e=dynamic_cast<CExplosion*>(this))base_radius=e->mRadius;base_mask=i->mInitCST.mNotSeekCollisionWithBF;base_map=!!(mFlags&TF_IN_MAP_WHO);selected_matrix=i->mOrientationType==DIRECTION_COSINE_MATRIX;if(selected_matrix)mOrientation=i->mOrientation;CThing::Init(i);}
void CComplexThing::Hit(CThing*,CCollisionReport*){++base_hits;trace.push_back("BaseHit");}
void own_sentinel(CExplosion&e){e.mPos={-111,-222,-333};e.mRadius=12345;e.mCurrentRadius=23456;e.mBehaviour=reinterpret_cast<CExplosionData*>(uintptr_t(1));e.mAllegiance=88;e.mColType=kCollideThing;}
void reset(int role,bool on){compatibility_refusal=false;LifeReset();birth_published=0;config.epoch=7;applied_tick=100;applied_sequence=1;EVENT_MANAGER.frame=100;EVENT_MANAGER.valid=true;GAME.mQuit=QT_NONE;GAME.level=852;GAME.players=2;GAME.state=GAME_STATE_PLAYING;assert(WORLD.things.v.empty());active=on;config.role=role;poisoned=applying=birth_failed=creating_explosion=false;binding_count=birth_count=birth_generated=birth_applied=0;next_id=1;applying_birth=nullptr;birth_spawn=nullptr;memset(bindings,0,sizeof bindings);memset(birth_journal,0,sizeof birth_journal);trace.clear();trail_calls=trail_kills=0;GAME.random_calls=0;collision_scans=collision_continuations=0;MAP.water=0;MAP.ground=10;MAP.ground_queries=0;MAP.ground_hit=false;allocations=heap_reads=base_inits=shutdowns=fx_calls=fx_positions=fx_orientations=fx_unlinks=sounds=lights=damage_calls=kills=base_hits=events_attempted=events_queued=attached_radius_reads=entry_calls=ready_calls=0;selected_pd=nullptr;important_arg=-1;light_size=base_radius=0;base_mask=0;base_map=-1;heap.free=204800;}
void forget_stack(CThing*t){WORLD.RemoveThing(t);binding_count=0;}
int tests=0;void check(bool yes,const char*name){if(!yes){std::cerr<<"FAIL "<<name<<" error="<<error_text<<"\n";std::exit(2);}++tests;std::cout<<"{\"case\":\""<<name<<"\",\"pass\":true}\n";}

struct GameBoundary{int mQuit=QT_NONE,level=852,players=2;EGameState state=GAME_STATE_PLAYING;unsigned random_calls=0;int Random(){++random_calls;return 17;}int GetCurrentLevel(){return level;}int GetNPlayers(){return players;}EGameState GetGameState(){return state;}}GAME;

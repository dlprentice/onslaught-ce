    char mLines[30][80]{}; float mLineTimes[30]{};
    CDebugLog(const char *path, bool enabled) : mFileName(const_cast<char *>(path)), mEnabled(enabled) {}
    void AddMessage(char *, ...); void AddString(char *, ...);
};
static char *sFallbackName = const_cast<char *>("c:\\setuphistory.txt");
CDebugLog LOG("c:\\debug.log", false), SETUP_HISTORY("setuphistory.txt", true);
@LOG_CALLERS@

extern "C" void CE_NetUpdateAutomationPrepare(void) { ++automation_prepare; }
extern "C" void PortInitializeContentRoots(void) { ++automation_prepare; PortPathsInit(); }
CCLIParams::CCLIParams() {
    std::memset(static_cast<void *>(this), 0, sizeof *this); mLevelNo = 852; mGoStraightToDeviceSelectScreen = -1;
    std::strcpy(mSampleBankRoot, ".");
}
void CCLIParams::GetParams(char *) { ++params_calls; }
CCLIParams CLIPARAMS;
bool E3_BUILD;
int PLAYABLE_DEMO;
char DEFAULT_OPTIONS_NAME[260] = "defaultoptions.bea";
static std::string mode, game, user;

static void Write(const std::string &path, const char *bytes) {
    FILE *f = std::fopen(path.c_str(), "wb"); Check(f, "fixture create");
    Check(std::fwrite(bytes, 1, std::strlen(bytes), f) == std::strlen(bytes) && !std::fclose(f), "fixture write");
}
static std::string Bytes(const std::string &path) {
    FILE *f = std::fopen(path.c_str(), "rb"); if (!f) return {};
    std::string result; char buf[256]; size_t n;
    while ((n = std::fread(buf, 1, sizeof buf, f))) result.append(buf, n);
    std::fclose(f); return result;
}
static void Context(bool expected) {
    CE_CompatibilityResult result; std::memset(&result, 0xa5, sizeof result);
    bool ok = CE_BootPrepared(&result, error, sizeof error) != 0;
    Check(ok == expected, expected ? "actual early boot supplies context" : "refusal cannot expose context");
    if (!expected) { CE_CompatibilityResult zero{}; Check(!std::memcmp(&zero, &result, sizeof zero), "refused context zeroed"); }
}

// The exact native option-load slice is compiled in Entry, with allocation/career effects controlled.
enum { MEMTYPE_SCRATCHPAD = 1, DEBUG_LOG_LINES = 30 };
void *operator new[](size_t size, int) { return ::operator new[](size); }
struct FakeCareer {
    static int SizeOfSaveGame() { return 8; }
    bool Load(const char *data, bool original) { Check(!original && !std::memcmp(data, "OPTIONS!", 8), "actual options caller bytes"); ++loaded; return true; }
    void Blank() { ++blanked; }
} CAREER;
using CCareer = FakeCareer;
bool OPTIONS_LOADED;

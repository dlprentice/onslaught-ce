static char error[192];
static void Check(bool ok, const char *message) {
    ++checks; if (!ok) { std::fprintf(stderr, "FAIL %s (%s)\n", message, error); std::exit(2); }
}
PortHandle *PortHandleNew(PortHandleKind kind, size_t size) {
    auto *p = static_cast<PortHandle *>(std::calloc(1, size)); if (p) p->kind = kind; return p;
}
void PortHandleFree(PortHandle *p) { std::free(p); }
PortHandle *PortCheck(HANDLE h, int kind) {
    auto *p = static_cast<PortHandle *>(h); return p && p->kind == kind ? p : nullptr;
}
void PortSetLastError(DWORD) {}

+// Ordinary CE alone uses staged refills. Forced CE drawing in a replay/recording must retain the original path.
+static bool sPortSafeMusicRefill;
+static BYTE sPortMusicRefill[STREAM_HALF];
+void PortAudioPublishMusicHalf(void *, const void *, DWORD);
+static bool PortSafeMusicRefill()
+{
+	if (!PortCeLayer() || PortClockVirtual()) return false;
+	const char *names[] = {"BEA_PORT_CLOCK", "BEA_PORT_TAPE", "BEA_PORT_PROBES", "BEA_PORT_RECORD"};
+	for (const char *name : names)
+	{
+		const char *value = getenv(name);
+		if (value && *value) return false;
+	}
+	return true;
+}
 

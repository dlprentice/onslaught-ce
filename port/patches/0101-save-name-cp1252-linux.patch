+#ifndef _WIN32
+// Port 0101: Linux career names. A UTF-8 file name of code page 1252 characters reaches the game as those characters (so
+// a Linux career named for the latete cheat has the 0xEA its code compares), and a career name with such characters is
+// saved under its UTF-8 name; an existing one-byte file of that name keeps its own name.
+// port/platform/linux/save_cp1252.cpp.
+extern "C" unsigned PortSaveNameFromFileCp1252(const char *, void *, unsigned);
+extern "C" int PortSaveFileFromNameCp1252(const void *, char *, unsigned);
+extern "C" int PortSaveLegacyFromNameCp1252(const void *, char *, unsigned);
+extern "C" unsigned PortSaveNameFromLegacyCp1252(const char *, void *, unsigned);
+
+static WCHAR *PortSaveWide(char *base)
+{
+	static WCHAR wide[256];
+	if (PortSaveNameFromFileCp1252(base, wide, 256))
+		return wide;
+	if (PortSaveNameFromLegacyCp1252(base, wide, 256))	// a one-byte name: its code page 1252 characters (0x99 is U+2122)
+		return wide;
+	return ToWCHAR(base);
+}
+
+static BOOL PortSaveLegacyExists(char *legacy)
+{
+	char path[MAX_PATH];
+	if (strlen(legacy) + sizeof(SAVE_DIRECTORY SAVE_EXTENSION) > sizeof(path))
+		return FALSE;
+	strcpy(path, SAVE_DIRECTORY);
+	strcat(path, legacy);
+	strcat(path, SAVE_EXTENSION);
+	return _access(path, 0) == 0;
+}
+
+// The old byte-for-byte file of a name counts as that career's file only when it exists and its bytes are not the UTF-8
+// file name of a different career: "BobA^(c)" written byte for byte is the UTF-8 file of "Bob(c)", and choosing it
+// would overwrite or delete that other career.
+static BOOL PortSaveLegacyTwin(char *legacy, const WCHAR *name)
+{
+	if (!PortSaveLegacyExists(legacy))
+		return FALSE;
+	static WCHAR decoded[256];
+	if (!PortSaveNameFromFileCp1252(legacy, decoded, 256))
+		return TRUE;
+	size_t i = 0;
+	for (; name[i] && decoded[i] == name[i]; ++i) {}
+	return decoded[i] == name[i];
+}
+
+// The file of a career name: its UTF-8 name, or the older byte-for-byte file of the same name when that is the one on
+// disk. The older name is the code page 1252 bytes of the name, never FromWCHAR's narrowing (U+2122 narrowed to '"', so
+// "A(TM)" took the file of the career "A\"").
+static char *PortSaveFile(WCHAR *name)
+{
+	static char file[256 * 3], legacy[256];
+	if (!PortSaveFileFromNameCp1252(name, file, sizeof(file)))
+		return FromWCHAR(name);		// ASCII only: the game's own name
+	if (PortSaveLegacyFromNameCp1252(name, legacy, sizeof(legacy)) && PortSaveLegacyTwin(legacy, name))
+		return legacy;
+	return file;
+}
+#endif
+
 static inline BOOL PortSaveEntryOK(const char *filename)
 {
 #ifdef _WIN32
 	return PortSaveNameUtf16(filename, NULL, 0) == 0;
 #else
-	return TRUE;
+	// A UTF-8 name whose Latin-1 twin also exists is listed once, as the twin (the file every name lookup chooses).
+	char base[256];
+	size_t n = strlen(filename);
+	if (n < 4 || n - 4 >= sizeof(base))
+		return TRUE;
+	memcpy(base, filename, n - 4);
+	base[n - 4] = 0;
+	static WCHAR wide[256];
+	if (!PortSaveNameFromFileCp1252(base, wide, 256))
+		return TRUE;
+	static char legacy[256];
+	return !(PortSaveLegacyFromNameCp1252(wide, legacy, sizeof(legacy)) && PortSaveLegacyTwin(legacy, wide));
 #endif
 }
 

+	const DWORD	savedAmbient = RENDERINFO.mAmbient;
+	const bool	savedLighting = RENDERINFO.mUnknown2ed;
+	const bool	savedFog = RENDERINFO.mFogEnabled;
+	CLight	savedLights[8];
+	bool	savedLightEnable[8];
+	for (SINT li = 0; li < 8; li++)
+	{
+		savedLights[li] = RENDERINFO.mLights[li];
+		savedLightEnable[li] = RENDERINFO.mLightEnable[li];
+	}
+
+	const float	distance = radius * 1.42f;
+	float	near_plane = 0.2f;
+	if (distance * 0.05f < near_plane)
+		near_plane = distance * 0.05f;
+	if (near_plane < 0.02f)
+		near_plane = 0.02f;
+	float	far_plane = 700.f;
+	if (distance * 4.f + radius * 4.f > far_plane)
+		far_plane = distance * 4.f + radius * 4.f;
+	const float	aspect = float(pane.Height) / float(pane.Width);
+
+	if (sCeCatalogueModelGoodie == 76)
+	{
+		const float	half = near_plane * 0.5f;
+		if (aspect >= 1.f)
+			RENDERINFO.SetProjection(near_plane, far_plane, half, half * aspect);
+		else
+			RENDERINFO.SetProjection(near_plane, far_plane, half / aspect, half);
+		FED.mCamera.mPos = FVector(0.0f, 0.0f, 0.0f);
+		FED.mCamera.mOrientation.MakeRotationF(0.0f, 0.0f, 0.0f);
+	}
+	else
+	{
+		const float	half = near_plane * 0.75f;
+		if (aspect >= 1.f)
+			RENDERINFO.SetProjection(near_plane, far_plane, half, half * aspect);
+		else
+			RENDERINFO.SetProjection(near_plane, far_plane, half / aspect, half);
+		// Camera at (0, -d, -0.7*d) aimed directly at the origin (atan2(0.7, 1.0) ~= 0.61 rad) to centre the model in the pane.
+		FED.mCamera.mPos = FVector(0.0f, -distance, -(distance * 0.7f));
+		FED.mCamera.mOrientation.MakeRotationF(0.0f, 0.61f, 0.0f);
+	}
+	FRONTEND.UpdateCamera();
+
+	FMatrix	ori;
+	ori.MakeRotationF(yaw, 0.0f, 0.0f);
+	const FVector	middle = mCurrentGoodyMesh->mBoundingBox->mOrigin;
+	FVector	pos = (sCeCatalogueModelGoodie == 76) ? -middle : -(ori * middle);
+
+	// Three-point studio lighting calibrated for D3DTOP_MODULATE2X (Goodie 76 Team Photo uses flat 1x ambient so it never blows out)
+	CLight	light;
+	RENDERINFO.SetAmbient(sCeCatalogueModelGoodie == 76 ? 0x00787878 : 0x00181c22);
+	FVector	sunlight = FVector(-5000.f, 5000.f, 1500.0f);
+	sunlight.Normalise();
+	FVector3	col1 = FVector3(0.80f, 0.50f, 0.30f), col2 = FVector3(0.28f, 0.48f, 0.85f), col3 = FVector3(0.42f, 0.42f, 0.42f);
+	col1 *= 0.52f;
+	col2 *= 0.52f;
+	col3 *= 0.48f;
+	light.Init(LIGHT_DIRECTIONAL, sunlight, col1.X, col1.Y, col1.Z);
+	RENDERINFO.SetLight(0, &light);
+	RENDERINFO.SetLightEnable(0, sCeCatalogueModelGoodie == 76 ? FALSE : TRUE);
+	sunlight.X = -sunlight.X;
+	light.Init(LIGHT_DIRECTIONAL, sunlight, col2.X, col2.Y, col2.Z);
+	RENDERINFO.SetLight(1, &light);
+	RENDERINFO.SetLightEnable(1, sCeCatalogueModelGoodie == 76 ? FALSE : TRUE);
+	sunlight = FVector(0.f, 1000.f, 200.f);
+	sunlight.Normalise();
+	light.Init(LIGHT_DIRECTIONAL, sunlight, col3.X, col3.Y, col3.Z);
+	RENDERINFO.SetLight(2, &light);
+	RENDERINFO.SetLightEnable(2, sCeCatalogueModelGoodie == 76 ? FALSE : TRUE);
+	for (SINT li = 3; li < 8; li++)
+		RENDERINFO.SetLightEnable(li, FALSE);
+	RENDERINFO.SetLightingEnabled(TRUE);
+	RENDERINFO.SetFogEnabled(false);
+
+	// Restore full 3D mesh render states (the 2D menu pass disables Z-write/Z-test and uses CLAMP + MODULATE)
+	LT.D3D_SetMaterial(STATE.GetDefaultMaterial());
+	LT.SRS(D3DRS_ZENABLE, D3DZB_TRUE);
+	LT.SRS(D3DRS_ZWRITEENABLE, TRUE);
+	LT.SRS(D3DRS_ZFUNC, D3DCMP_LESSEQUAL);
+	LT.SRS(D3DRS_CULLMODE, D3DCULL_CCW);
+	LT.SRS(D3DRS_FILLMODE, D3DFILL_SOLID);
+	LT.SRS(D3DRS_ALPHATESTENABLE, TRUE);
+	LT.SetAlphaRef(8);
+	LT.SRS(D3DRS_ALPHAFUNC, D3DCMP_GREATEREQUAL);
+	LT.SRS(D3DRS_ALPHABLENDENABLE, TRUE);
+	LT.SRS(D3DRS_SRCBLEND, D3DBLEND_SRCALPHA);
+	LT.SRS(D3DRS_DESTBLEND, D3DBLEND_INVSRCALPHA);
+	LT.SRS(D3DRS_COLORVERTEX, TRUE);
+	LT.SRS(D3DRS_DIFFUSEMATERIALSOURCE, D3DMCS_COLOR1);
+	LT.SRS(D3DRS_AMBIENTMATERIALSOURCE, D3DMCS_COLOR1);
+	LT.STS(0, D3DTSS_COLORARG1, D3DTA_TEXTURE);
+	LT.STS(0, D3DTSS_COLORARG2, D3DTA_DIFFUSE);
+	LT.SetModulate(0);
+	LT.STS(0, D3DTSS_ALPHAOP, D3DTOP_MODULATE);
+	LT.STS(0, D3DTSS_ALPHAARG1, D3DTA_TEXTURE);
+	LT.STS(0, D3DTSS_ALPHAARG2, D3DTA_DIFFUSE);
+	LT.STS(1, D3DTSS_COLOROP, D3DTOP_DISABLE);
+	LT.STS(1, D3DTSS_ALPHAOP, D3DTOP_DISABLE);
+	RENDERINFO.STS(0, TSS_ADDRESSU, TADDRESS_WRAP);
+	RENDERINFO.STS(0, TSS_ADDRESSV, TADDRESS_WRAP);
+	RENDERINFO.Apply();
+
+	const SINT	alpha_was = CMESHRENDERER::GetRenderAlpha();
+	const ERenderMode	mode_was = CMESHRENDERER::GetRenderMode();
+	CMESHRENDERER::SetRenderAlpha(255);
+	CMESHRENDERER::SetRenderMode(R_Normal);
+	CMESHRENDERER::Render(&pos, &ori, mCurrentGoodyMesh, NULL, NULL, 0, FALSE, 0);
+	CMESHRENDERER::SetRenderAlpha(alpha_was);
+	CMESHRENDERER::SetRenderMode(mode_was);
+
+	// Put the pane's Z-buffer back to panel depth (0.55f < 0.998f) so CFEPCommon::RenderSmallBEALogo's shine pass
+	// (drawn at z=0.998 with ZFUNC=LESSEQUAL) is Z-rejected over the model pane, as CFEPGoodies::Render does.
+	device->Clear(0, NULL, D3DCLEAR_ZBUFFER, 0, 0.55f, 0);
+
+	// Restore every D3D9 state from the state block, resync LT's shadow cache, and restore RENDERINFO's cached state
+	savedState->Apply();
+	savedState->Release();
+	LT.InvalidateAllStates();
+	RENDERINFO.SetAmbient(savedAmbient);
+	for (SINT li = 0; li < 8; li++)
+	{
+		RENDERINFO.SetLight(li, &savedLights[li]);
+		RENDERINFO.SetLightEnable(li, savedLightEnable[li]);
+	}
+	RENDERINFO.SetLightingEnabled(savedLighting);
+	RENDERINFO.SetFogEnabled(savedFog);
+	RENDERINFO.mProjection = *(SRenderMatrix *)&savedProj;
+	RENDERINFO.mProjectionChanged = true;
+	RENDERINFO.mWorld = *(SRenderMatrix *)&savedWorld;
+	RENDERINFO.mWorldChanged = true;
+	FED.mCamera.mPos = savedCamPos;
+	FED.mCamera.mOrientation = savedCamOri;
+	FRONTEND.UpdateCamera();
+	RENDERINFO.Apply();
+	device->SetViewport(&whole);
+	return true;
+}
+
+extern "C" bool	PortCeGoodieModelLoad(int goodie)
+{
+	return FRONTEND.mFEPGoodies.CeCatalogueLoad(goodie);
+}
+
+extern "C" void	PortCeGoodieModelFree()
+{
+	FRONTEND.mFEPGoodies.CeCatalogueFree();
+}
+
+extern "C" bool	PortCeGoodieModelDraw(float left, float top, float right, float bottom, float yaw)
+{
+	return FRONTEND.mFEPGoodies.CeCatalogueDraw(left, top, right, bottom, yaw);
+}
+#endif
+

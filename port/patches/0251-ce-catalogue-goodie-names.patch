+#ifdef CE_VERSION
+// CE (patch 0251): the Catalogue's rotating 3D model preview (port/game/ce_catalogue_list.cpp).
+// Uses this page's goodie slots while Goodies is inactive: Load reads one model goodie's mesh and textures via
+// ReadResources, Free releases them, and Draw renders the mesh lit as Goodies lights it, centered on its bounding
+// sphere and framed inside a virtual 640x480 rectangle with full D3D9 state-block, RENDERINFO and Z-buffer restoration.
+#include	"ltshell.h"
+
+bool	CFEPGoodies::CeCatalogueLoad(int goodie)
+{
+	FreeUpGoodyResources();
+	if (goodie < 0 || goodie >= MAX_NUM_GOODIES || get_goodie_type_hack(goodie) != GT_MESH)
+		return false;
+	CResourceAccumulator::ReadResources(-1000 - goodie);
+	if (!mCurrentGoodyMesh || mCurrentGoodyMesh->mNumParts <= 0 || !mCurrentGoodyMesh->mBoundingBox)
+	{
+		FreeUpGoodyResources();
+		return false;
+	}
+	sCeCatalogueModelHeld = true;
+	sCeCatalogueModelGoodie = goodie;
+	return true;
+}
+
+void	CFEPGoodies::CeCatalogueFree()
+{
+	FreeUpGoodyResources();
+}
+
+bool	CFEPGoodies::CeCatalogueDraw(float left, float top, float right, float bottom, float yaw)
+{
+	IDirect3DDevice9	*device = LT.GetDevice();
+	if (!sCeCatalogueModelHeld || !mCurrentGoodyMesh || mCurrentGoodyMesh->mNumParts <= 0 || !mCurrentGoodyMesh->mBoundingBox || !device || right - left < 8.f || bottom - top < 8.f)
+		return false;
+	const float	radius = mCurrentGoodyMesh->mBoundingBox->mRadius;
+	if (!(radius > 1e-4f) || !(radius < 1e6f))
+		return false;
+
+	D3DVIEWPORT9	whole, pane;
+	if (FAILED(device->GetViewport(&whole)))
+		return false;
+	float	sx = whole.Width / 640.f, sy = whole.Height / 480.f, ox = float(whole.X), oy = float(whole.Y);
+	if (PortWideActive())
+	{
+		sx = sy = PortUiScale();
+		ox = PortUiLeft();
+		oy = PortUiTop();
+	}
+	int	px0 = int(ox + left * sx + 0.5f), py0 = int(oy + top * sy + 0.5f);
+	int	px1 = int(ox + right * sx + 0.5f), py1 = int(oy + bottom * sy + 0.5f);
+	const int	wx0 = int(whole.X), wy0 = int(whole.Y);
+	const int	wx1 = int(whole.X + whole.Width), wy1 = int(whole.Y + whole.Height);
+	if (px0 < wx0) px0 = wx0;
+	if (py0 < wy0) py0 = wy0;
+	if (px1 > wx1) px1 = wx1;
+	if (py1 > wy1) py1 = wy1;
+	if (px1 - px0 < 4 || py1 - py0 < 4)
+		return false;
+	pane = whole;
+	pane.X = DWORD(px0);
+	pane.Y = DWORD(py0);
+	pane.Width = DWORD(px1 - px0);
+	pane.Height = DWORD(py1 - py0);
+	pane.MinZ = 0.0f;
+	pane.MaxZ = 1.0f;

+#include "../platform/common/replay_cheat.h"	// port 0258: PortReplayCheatRequested
+#include "../platform/common/portlog.h"	// port 0258: PORT_LOG_PREFIX
+// Port (patch 0258): the careers a cheat replay has deleted. Nothing is deleted on disk, so CreateSave counts these names as
+// gone for the rest of the replay, as they would be after a real delete.
+static WCHAR	sCheatGone[16][33];
+static int		sCheatGoneCount;
+
+static BOOL CheatGone(const WCHAR *name, BOOL forget)
+{
+	for (int k = 0; k < sCheatGoneCount; k++)
+		if (_wcsicmp(sCheatGone[k], name) == 0)
+		{
+			if (forget)
+				memcpy(sCheatGone[k], sCheatGone[--sCheatGoneCount], sizeof(sCheatGone[k]));
+			return TRUE;
+		}
+	return FALSE;
+}
+
+// CreateSave in a cheat replay: the answer the card would give, with nothing made on disk. A name that is a career (and
+// not deleted in this replay) is admitted as usual; a new one is reported as created, at the place it would take in the
+// list. Admitting an existing career never writes, here or in the plain path.
+static int CheatCreateSave(CPCMemoryCard *card, int number, WCHAR *name, int *save, BOOL allowed_overwrite)
+{
+	int count = 0, before = 0;
+	BOOL gone = CheatGone(name, TRUE);
+	card->GetNumSaves(number, &count);
+	for (int k = 0; k < count; k++)
+	{
+		WCHAR other[256];
+		if (card->GetSaveName(number, k, other) != MCE_SUCCESS)
+			continue;
+		int order = _wcsicmp(other, name);
+		if (order == 0 && !gone)
+		{
+			if (save) *save = k;
+			return allowed_overwrite ? MCE_SUCCESS : MCE_FILEEXISTS;
+		}
+		if (order < 0)
+			before++;
+	}
+	if (save) *save = before;
+	return MCE_SUCCESS;
+}
+

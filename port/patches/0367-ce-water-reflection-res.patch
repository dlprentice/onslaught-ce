+static bool CeCreateMirrorTargetsAt(unsigned res, bool readableZ, bool zAsTex,
+	IDirect3DTexture9 **outMirror, IDirect3DTexture9 **outDepthTex, IDirect3DSurface9 **outDepthSurf)
+{
+	*outMirror = NULL;
+	*outDepthTex = NULL;
+	*outDepthSurf = NULL;
+	const unsigned depthRes = (readableZ && res < 512u) ? 512u : res;
+	if (FAILED(LT.D3D_CreateTextureNoCheck(res, res, 1, D3DUSAGE_RENDERTARGET, D3DFMT_R5G6B5, D3DPOOL_DEFAULT, outMirror)) || !*outMirror)
+	{
+		SAFE_RELEASE(*outMirror);
+		return false;
+	}
+	HRESULT dhr = E_FAIL;
+	if (zAsTex)
+	{
+		dhr = LT.D3D_CreateTextureNoCheck(depthRes, depthRes, 1, D3DUSAGE_DEPTHSTENCIL, D3DFMT_D16, D3DPOOL_DEFAULT, outDepthTex);
+		if (SUCCEEDED(dhr) && *outDepthTex)
+			dhr = (*outDepthTex)->GetSurfaceLevel(0, outDepthSurf);
+	}
+	else
+		dhr = LT.GetDevice()->CreateDepthStencilSurface(depthRes, depthRes, D3DFMT_D16, D3DMULTISAMPLE_NONE, 0, TRUE, outDepthSurf, NULL);
+	if (FAILED(dhr) || !*outDepthSurf)
+	{
+		SAFE_RELEASE(*outDepthSurf);
+		SAFE_RELEASE(*outDepthTex);
+		SAFE_RELEASE(*outMirror);
+		return false;
+	}
+	return true;
+}
+
+void CeLandscapeSyncWaterReflection(CDXLandscape *land)
+{
+	if (!land || !land->mMirrorTexture || GAME.IsMultiplayer() || !EXTRA_GEFORCE_FX_FEATURES.mValue)
+		return;
+	CeRenderTargetQualitySetHardwareCaps(LT.m_d3dCaps.MaxTextureWidth, LT.m_d3dCaps.MaxTextureHeight);
+	if (!CeWaterReflectionNeedsRebuild())
+		return;
+	const unsigned attempt = CeWaterReflectionTargetRes();
+	unsigned res = attempt;
+	IDirect3DTexture9 *newMirror = NULL;
+	IDirect3DTexture9 *newDepthTex = NULL;
+	IDirect3DSurface9 *newDepthSurf = NULL;
+	while (res >= 256u)
+	{
+		if (CeCreateMirrorTargetsAt(res, MY_READABLE_Z_BUFFER.mValue != 0, OTHER_ZBUFFER_AS_TEXTURE.mValue != 0,
+			&newMirror, &newDepthTex, &newDepthSurf))
+		{
+			SAFE_RELEASE(land->mDepthSurface);
+			SAFE_RELEASE(land->mDepthTexture);
+			SAFE_RELEASE(land->mMirrorTexture);
+			land->mMirrorTexture = newMirror;
+			land->mDepthTexture = newDepthTex;
+			land->mDepthSurface = newDepthSurf;
+			CeWaterReflectionSetAllocatedRes(res, attempt);
+			return;
+		}
+		res = CeWaterReflectionNextFallback(res);
+	}
+	CeWaterReflectionSetAllocatedRes(CeWaterReflectionActiveRes(), attempt);
+}

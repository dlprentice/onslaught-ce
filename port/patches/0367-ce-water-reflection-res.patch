+	CDXLandscape *mOwner;
+	CeLandscapeMirrorDeviceHook() : mOwner(NULL) {}
+	void Attach(CDXLandscape *owner)
+	{
+		if (mOwner == owner) return;
+		if (mOwner) LT.RemoveDeviceObject(this);
+		mOwner = owner;
+		if (mOwner) LT.AddDeviceObject(this);
+	}
+	void Detach(CDXLandscape *owner)
+	{
+		if (mOwner != owner) return;
+		LT.RemoveDeviceObject(this);
+		mOwner = NULL;
+	}
+	HRESULT InvalidateDeviceObjects()
+	{
+		if (mOwner)
+		{
+			SAFE_RELEASE(mOwner->mUnknown08);
+			SAFE_RELEASE(mOwner->mDepthTexture);
+			SAFE_RELEASE(mOwner->mDepthSurface);
+			SAFE_RELEASE(mOwner->mMirrorTexture);
+			CeWaterReflectionResetAllocated();
+		}
+		return S_OK;

+#include "../platform/common/replay_cheat.h"	// port 0352: PortReplayCheatRequested
+#include "../platform/common/portlog.h"	// port 0352: PORT_LOG_PREFIX
+// Port (patch 0352): a cheat replay (BEA_PORT_REPLAY_CHEAT, replay.cpp) keeps the careers in memory and touches no career
+// file. Its first card call takes the list from disk; from then on GetNumSaves, GetSaveName, CreateSave, ReadSave,
+// WriteSave and DeleteSave answer from that list, so the front end goes the way it went when the tape was recorded. A
+// career's bytes are its file's until the replay writes it.
+struct SCheatCareer
+{
+	WCHAR	name[256];
+	BOOL	held;		// data/size are the career (created or written in this replay); otherwise its file is
+	char	*data;
+	int		size;
+};
+static SCheatCareer	*sCheatCareers;
+static int			sCheatCount, sCheatRoom;
+static BOOL			sCheatListed, sCheatListing;
+
+// Whether a card call answers from the list: a cheat replay, and not the card's own listing that fills it.
+static BOOL CheatCareers()
+{
+	return PortReplayCheatRequested() && !sCheatListing;
+}
+
+static int CheatFind(const WCHAR *name)
+{
+	if (!name)
+		return -1;
+	for (int k = 0; k < sCheatCount; k++)
+		if (_wcsicmp(sCheatCareers[k].name, name) == 0)
+			return k;
+	return -1;
+}
+
+static BOOL CheatInsert(int at, const WCHAR *name)
+{
+	if (sCheatCount == sCheatRoom)
+	{
+		int room = sCheatRoom ? sCheatRoom * 2 : 16;
+		SCheatCareer *grown = (SCheatCareer *)realloc(sCheatCareers, room * sizeof(SCheatCareer));
+		if (!grown)
+			return FALSE;
+		sCheatCareers = grown;
+		sCheatRoom = room;
+	}
+	memmove(sCheatCareers + at + 1, sCheatCareers + at, (sCheatCount - at) * sizeof(SCheatCareer));
+	SCheatCareer *c = sCheatCareers + at;
+	int n = 0;
+	for (; n < 255 && name[n]; n++)
+		c->name[n] = name[n];
+	c->name[n] = 0;
+	c->held = FALSE;
+	c->data = NULL;
+	c->size = 0;
+	sCheatCount++;
+	return TRUE;
+}
+
+static void CheatList(CPCMemoryCard *card, int number)
+{
+	if (sCheatListed)
+		return;
+	sCheatListed = sCheatListing = TRUE;
+	int count = 0;
+	card->GetNumSaves(number, &count);
+	for (int k = 0; k < count; k++)
+	{
+		WCHAR name[256];
+		if (card->GetSaveName(number, k, name) == MCE_SUCCESS && CheatFind(name) < 0)
+			CheatInsert(sCheatCount, name);
+	}
+	sCheatListing = FALSE;
+	fprintf(stderr, PORT_LOG_PREFIX "replay: cheat replay: careers kept in memory (%d on disk)\n", sCheatCount);
+	fflush(stderr);
+}
+
+// CreateSave: an existing career is admitted as the card admits it; a new one goes in at the place the card would list it,
+// empty, as the card's new file is.
+static int CheatCreateSave(CPCMemoryCard *card, int number, WCHAR *name, int *save, BOOL allowed_overwrite)
+{
+	if (save) *save = -1;
+	if (!name)
+		return MCE_FAILURE;
+	CheatList(card, number);
+	int k = CheatFind(name);
+	if (k >= 0)
+	{
+		if (save) *save = k;
+		return allowed_overwrite ? MCE_SUCCESS : MCE_FILEEXISTS;
+	}
+	int at = 0;
+	for (k = 0; k < sCheatCount; k++)
+		if (_wcsicmp(sCheatCareers[k].name, name) < 0)
+			at++;
+	if (!CheatInsert(at, name))
+		return MCE_FAILURE;
+	sCheatCareers[at].held = TRUE;
+	if (save) *save = at;
+	return MCE_SUCCESS;
+}

+//******************************************************************************************
+// Port (patch 0035): under the virtual clocks, handle every wake the stream thread would have had by now, on the calling
+// (main) thread. GetStatus first brings the mix to the virtual time now, so the position notifications due by then are
+// set whichever thread mixed; each event is then taken without waiting and handled as the thread would. Real time:
+// nothing (the thread runs).
+void	PumpMusicStream()
+{
+	if (!sBuffer || !PortClockVirtual())
+		return;
+	DWORD	status;
+	sBuffer->GetStatus(&status);
+	HANDLE	events[4] = { sPlayEvent, sFirstHalfEvent, sSecondHalfEvent, sQuitEvent };
+	for (;;)
+	{
+		DWORD	result = WaitForMultipleObjects(4, events, FALSE, 0);
+		if (result > 3)
+			break;
+		sWaitResult = result;
+		sThreadAwake = TRUE;
+		int	quit = MusicStreamHandle(result);
+		sThreadAwake = FALSE;
+		if (quit)
+			break;
 	}
 }
 

+		FVector((((a.Row[1].Y * b.Row[1].X) + (a.Row[1].Z * b.Row[2].X)) + (a.Row[1].X * b.Row[0].X)),
+			(((a.Row[1].Z * b.Row[2].Y) + (a.Row[1].Y * b.Row[1].Y)) + (a.Row[1].X * b.Row[0].Y)),

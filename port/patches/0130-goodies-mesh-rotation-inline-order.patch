+// Port (patch 0130): retail compiles the goodies mesh viewer's turn inline in CFEPGoodies::ButtonPressed (pristine
+// 74154bfa, 0045d376..0045d56a): the rotation by (yaw, pitch, roll) and its product with the mesh's orientation, with
+// this copy's own choices, not those of the out-of-line copies (004062d0 and 0040d320) that MakeRotationF and
+// FMatrix::operator* follow with patches 0007 and 0094.
+// The rotation: the three cosines, sin(yaw) and sin(roll) are stored as floats, and fsin(pitch) stays on the x87 stack
+// at full precision (the transcendentals ignore the precision control). Rows 0 and 1 are stored as floats. Row 2 is
+// never stored: -(cp * sr) and cp * cr are products, which the game's control word has already rounded to 24 bits,
+// and between them is the unrounded sine, which every row 2 cell of the product multiplies as it is.
+// The product: each cell adds the bracketed pair first, then the last term. Name ours.
+static FMatrix	GoodiesMeshTurn(float yaw, float pitch, float roll, const FMatrix &m)
+{
+	volatile float cy = cosf(yaw), sy = sinf(yaw);
+	volatile float cr = cosf(roll), sr = sinf(roll);
+	volatile float cp = cosf(pitch);
+	long double sp = bea_x87_fsinl(pitch);
+	long double spsr = sp * sr;
+	volatile float spcr = (float)(sp * cr);
+	const FVector A((float)((long double)cr * cy - spsr * sy), (float)(-((long double)cp * sy)), (float)((long double)sr * cy + (long double)spcr * sy));
+	const FVector B((float)((long double)cr * sy + spsr * cy), (float)((long double)cp * cy), (float)((long double)sr * sy - (long double)spcr * cy));
+	const float cx = (float)(-((long double)cp * sr)), cz = (float)((long double)cp * cr);	// row 2's X and Z; its Y is sp
+	return FMatrix(
+		FVector(((A.X * m.Row[0].X) + (A.Z * m.Row[2].X)) + (A.Y * m.Row[1].X),
+			((A.Y * m.Row[1].Y) + (A.Z * m.Row[2].Y)) + (A.X * m.Row[0].Y),
+			((A.X * m.Row[0].Z) + (A.Z * m.Row[2].Z)) + (A.Y * m.Row[1].Z)),
+		FVector(((B.Z * m.Row[2].X) + (B.X * m.Row[0].X)) + (B.Y * m.Row[1].X),
+			((B.X * m.Row[0].Y) + (B.Y * m.Row[1].Y)) + (B.Z * m.Row[2].Y),
+			((B.Z * m.Row[2].Z) + (B.X * m.Row[0].Z)) + (B.Y * m.Row[1].Z)),
+		FVector((float)(((sp * m.Row[1].X) + (cz * m.Row[2].X)) + (cx * m.Row[0].X)),
+			(float)(((cx * m.Row[0].Y) + (cz * m.Row[2].Y)) + (sp * m.Row[1].Y)),
+			(float)(((sp * m.Row[1].Z) + (cz * m.Row[2].Z)) + (cx * m.Row[0].Z))));
+}

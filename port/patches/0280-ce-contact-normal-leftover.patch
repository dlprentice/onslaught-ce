 // operator new copy instead open an object of their own before Compass.obj (00426ff0).
 #include "mathsconst2.h"	// FUNCTION: 0x00426ee0 init:ZERO_FVECTOR2
 						// FUNCTION: 0x00426f00 init:ID_FMATRIX2
+
+// Patch 0280: the contact normals a report does not set, as the original leaves them (port/include/ce_contact_leftover.h,
+// port/PARITY.md "The unset contact normals"). Simulation state only: lockstep peers compute the same values.
+namespace
+{
+float sLeftover[6][3];						// the original's six normals at the scheduled check's stack depth
+const CEvent *sFlushEvent;					// the event CEventManager::Flush is delivering
+bool sScheduled, sFlushMove, sMultiplied;
+int sAirDepth = CE_AIR_MOVE_DIRECT;
+void SetRow(int slot, const FVector &v) { sLeftover[slot][0] = v.X; sLeftover[slot][1] = v.Y; sLeftover[slot][2] = v.Z; }
+}
+
+void CE_ContactLeftoverReset() { for (int i = 0; i < 6; ++i) sLeftover[i][0] = sLeftover[i][1] = sLeftover[i][2] = 0.f; }
+void CE_ContactLeftoverDispatch(const CEvent *event) { sFlushEvent = event; }
+void CE_ContactLeftoverShutdown(const CEvent *event) { if (event && event == sFlushEvent) CE_ContactLeftoverReset(); }
+void CE_ContactLeftoverCheckBegin(const CEvent *event) { sScheduled = event && event == sFlushEvent; }
+void CE_ContactLeftoverCheckEnd() { sScheduled = false; }
+bool CE_ContactLeftoverStart(CCollisionReport &report)
+{
+	const bool scheduled = sScheduled;
+	sScheduled = false;						// a check nested in a Hit callback is not the scheduled one
+	for (int i = 0; i < 6; ++i)
+	{
+		report.mNormals[i].X = scheduled ? sLeftover[i][0] : 0.f;
+		report.mNormals[i].Y = scheduled ? sLeftover[i][1] : 0.f;
+		report.mNormals[i].Z = scheduled ? sLeftover[i][2] : 0.f;
+	}
+	return scheduled;
+}
+void CE_ContactLeftoverEnd(const CCollisionReport &report, bool scheduled)
+{
+	// Normal 0 is not carried: in the recorded play the original's unset normal 0 never held an earlier report's normal
+	// (something else always overwrote it, mostly values that are not unit vectors), so it stays zero.
+	if (scheduled)
+		for (int i = 1; i < 6; ++i)
+			SetRow(i, report.mNormals[i]);
+}
+void CE_ContactLeftoverMoveBegin(const CEvent *event) { sFlushMove = event && event == sFlushEvent; }
+void CE_ContactLeftoverMoveEnd() { sFlushMove = false; sAirDepth = CE_AIR_MOVE_DIRECT; }
+void CE_ContactLeftoverAirDepth(int depth)
+{
+	sAirDepth = depth;
+	// CBomber and CCarver enter CAirUnit::Move 0x28 deeper: each GetEmitter call's arguments (an index and two stack
+	// addresses) land on normal 2 and its return address on normal 1, which read as zero. For CCarrier, CDropship and
+	// CFenrir nobody has derived what lands there; zero is the closest value the recorded play supports.
+	if (depth == CE_AIR_MOVE_NONE && sFlushMove)
+		for (int i = 1; i <= 2; ++i)
+			sLeftover[i][0] = sLeftover[i][1] = sLeftover[i][2] = 0.f;
+}
+void CE_ContactLeftoverEmitterBegin() { sMultiplied = false; }
+void CE_ContactLeftoverMultiplied() { sMultiplied = true; }
+void CE_ContactLeftoverEmitter(const FMatrix &ori, bool moveOri)
+{
+	if (!sFlushMove)
+		return;
+	if (sAirDepth == CE_AIR_MOVE_DIRECT)
+	{
+		// CUnit::GetEmitter's product (its local at entry - 0x30) on normals 1 to 3; without the product the original
+		// leaves other values there, which this treats as zero.
+		for (int r = 0; r < 3; ++r)
+		{
+			if (sMultiplied)
+				SetRow(1 + r, ori.Row[r]);
+			else
+				sLeftover[1 + r][0] = sLeftover[1 + r][1] = sLeftover[1 + r][2] = 0.f;
+		}
+	}
+	else if (sAirDepth == CE_AIR_MOVE_PLANE)
+	{
+		if (moveOri)
+			for (int r = 0; r < 3; ++r)
+				SetRow(2 + r, ori.Row[r]);	// CAirUnit::Move's `ori` on normals 2 to 4
+		else
+			SetRow(5, ori.Row[0]);			// `smoke_ori`'s first row on normal 5
+	}
+}

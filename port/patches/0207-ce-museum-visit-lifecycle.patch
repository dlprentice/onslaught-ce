+#ifdef CE_VERSION
+// CE museum bodies are already decoded. They are not AYA packed files or
+// borrowed parser buffers: this reader owns a copy until Close/destruction.
+BOOL CDXMemBuffer::InitOwnedRead(const void *data, UINT length, EMemoryType memtype)
+{
+    if (mData || !data || !length || length > 16u * 1024u * 1024u)
+        return FALSE;
+    char *owned = new(memtype) char[length];
+    if (!owned)
+        return FALSE;
+    memcpy(owned, data, length);
+    mData = owned;
+    mPtr = owned;
+    mSize = mDataSize = static_cast<SINT>(length);
+    mMemType = memtype;
+    mReading = TRUE;
+    mEOF = FALSE;
+    mLastBlock = TRUE;
+    mPos = 0;
+    mFile = NULL;
+    mFileName[0] = 0;
+    mCRCData = NULL;
+    mCRCDataUpTo = NULL;
+    mCRCFile = NULL;
+    return TRUE;
+}
+#endif

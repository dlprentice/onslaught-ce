+#ifdef CE_VERSION
+CMesh *CMesh::FindLoadedUnique(const char *name)
+{
+    if (!name || !*name) return NULL;
+    CMesh *match = NULL;
+    unsigned visited = 0;
+    for (CMesh *mesh = sFirst; mesh; mesh = mesh->mNextMesh)
+    {
+        if (++visited > 8192) return NULL;
+        if (!memchr(mesh->mName, 0, sizeof(mesh->mName))) return NULL;
+        if (!stricmp(name, mesh->mName))
+        {
+            if (match) return NULL;
+            match = mesh;
+        }
+    }
+    return match;
+}
+#endif

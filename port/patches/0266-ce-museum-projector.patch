+extern "C" bool PortCeMuseumCinemaFilmName(unsigned index,char *stem,unsigned cap)
+{
+    if (!stem || cap<128) return false;
+    for (SINT n=0;n<MAX_NUM_GOODIES;++n) {
+        if (get_goodie_type_hack(n)!=GT_FMV) continue;
+        if (index) { --index;continue; }
+        char filename[256]={};get_goodie_fmv(filename,n);
+        unsigned count=0;
+        for (;filename[count];++count) {
+            const unsigned char c=filename[count];
+            if (count+1>=cap || !((c>='A' && c<='Z') || (c>='a' && c<='z') ||
+                (c>='0' && c<='9') || c=='_' || c=='-' || c==' ')) return false;
+        }
+        if (!count) return false;
+        memcpy(stem,filename,count+1);return true;
+    }
+    return false;
+}

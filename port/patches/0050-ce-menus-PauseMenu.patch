+// Port (patch 0050, the CE layer): the options page's Cheats item and list (port/game/ce_frontend.cpp). Without the CE
+// menus (replays, recordings, the harness, private builds) the options page is the game's own.
+bool				PortCeMenus();
+CMenuItem			*PortCeCheatsItem();
+CMenuOptionsList	*PortCeCheatsList(float y);
+void				PortCeOptionsMenu(CPauseMenu *menu, bool alive);
+#define				PORT_CE_CHEATS_PCTEXT	0x4345
+
+// Port: the God item's switch with no player. The front end's options page shows it too (its controls list is the pause
+// menu's), where GAME.GetPlayer(0) is NULL and retail's SetIsGod call crashes; there it sets the career's god flag, which
+// CPlayer reads when a level makes the player (Player.cpp). In a level it is the player's SetIsGod, as in retail.
+static void	PortSetGod(BOOL val)
+{
+	CPlayer *player = GAME.GetPlayer(0);
+	if (player)
+		player->SetIsGod(val);
+	else
+		CAREER.SetIsGod(0, val);
+}
+#endif
+

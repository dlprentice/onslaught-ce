+		return;
+	land->mVertexShader = CVertexShader::Create("LandscapeShader", (DWORD *)
+		"vs.1.1\n"
+		"\n"
+		"dcl_position v0\n"
+		"dcl_texcoord v7\n"
+		"\n"
+		"; world/view/projection\n"
+		"\n"
+		"dp4 r2.x, v0, c[4]\n"
+		"dp4 r2.y, v0, c[5]\n"
+		"dp4 r2.z, v0, c[6]\n"
+		"dp4 r2.w, v0, c[7]\n"
+		"\n"
+		"dp4 r3.x, r2, c[8]\n"
+		"dp4 r3.y, r2, c[9]\n"
+		"dp4 r3.z, r2, c[10]\n"
+		"dp4 r3.w, r2, c[11]\n"
+		"\n"
+		"mov oPos, r3\n"
+		"\n"
+		"; stick z in the red, green and blue channels\n"
+		"mul oT0.xyz, r3.z, c[95].z\n"
+		"mov oT0.w, c[94].w\n", 4, NULL, 0, -1);
+	PortCeGraphicsResourceOutcome(CE_GRAPHICS_LANDSCAPE_VERTEX, land->mVertexShader && land->mVertexShader->mShader);
+}

--- a/PCMusic.cpp
+++ b/PCMusic.cpp
@@ -0,0 +1 @@
+#include "../platform/common/portlog.h"
@@ -40,6 +41,19 @@
 
 void CPCMusic::DeviceSetVolume(int vol)	// FUNCTION: 0x00515370
 {
+#ifdef CE_VERSION
+	if (PortSessionEnabled())
+	{
+		static bool portVolumeSeen;
+		static int portLastVolume;
+		if (!portVolumeSeen || portLastVolume != vol)
+		{
+			PortSessionLog(PORT_SESSION_MUSIC, false, "requested volume_0_127=%d", vol);
+			portVolumeSeen = true;
+			portLastVolume = vol;
+		}
+	}
+#endif
 	SetMusicStreamVolume(vol * (1.0f * 0.007874016f /* retail 005e4978: / 127.0f */));	// spelling chosen to give retail's own float-folded 1/127 (Music.obj's is the division in music.h): placement evidence; Stuart's release has no such line
 }
 

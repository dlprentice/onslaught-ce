+
+// Port: publish worker completion to the main-thread playlist poll without changing the matching source layout.
+// Every port write and poll, including faithful/private paths, uses the same atomic access.
+static void SetMusicStreamFinished(bool finished)
+{
+	__atomic_store_n(&MUSIC_STREAM_FINISHED, finished, __ATOMIC_RELEASE);
+}
+bool GetMusicStreamFinished()
+{
+	return __atomic_load_n(&MUSIC_STREAM_FINISHED, __ATOMIC_ACQUIRE);
+}

+		campos.X >= 0 && campos.Y >= 0 && campos.X < width && campos.Y < height ? 1 : 0;
+	if (band == lastBand && inside == lastInside && width == lastWidth && height == lastHeight && map == lastMap) return;
+	lastBand = band; lastInside = inside; lastWidth = width; lastHeight = height; lastMap = map;
+	++events;

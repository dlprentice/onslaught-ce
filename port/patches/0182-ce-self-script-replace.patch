 static WCHAR	sSpeaker[256];			// 0089c328: AddMessage's speaker
 
+#ifdef CE_VERSION
+// An active script may replace itself only after OP_CALL has finished touching it. The game owns both
+// monitored objects; these readers cancel the request if either goes away before the instruction returns.
+struct CeSelfReplacement
+{
+    CActiveReader<IScript> script;
+    CActiveReader<CComplexThing> owner;
+    char name[256];
+    CVM *vm;
+    bool pending;
+    CeSelfReplacement() : vm(NULL), pending(false) { name[0] = '\0'; }
+};
+static CeSelfReplacement sCeSelfReplacement;
+
+static bool PortCeDeferSelfReplacement(IScript *script, const char *name)
+{
+    extern bool PortModLevelSupplied(int level);
+    if (!MISSION_SCRIPT_VM.mRunning || MISSION_SCRIPT_VM.mCode != script->mCode ||
+        !script->mDefaultThing || script->mThing != script->mDefaultThing ||
+        script->mDefaultThing->GetMissionScript() != script ||
+        !PortModLevelSupplied(GAME.GetCurrentLevel()))
+        return false;
+    if (sCeSelfReplacement.pending)
+    {
+        LOG.AddString("CE: a second self-replacement during one instruction was ignored.\n");
+        return true;
+    }
+    size_t i = 0;
+    if (name)
+    {
+        for (; i + 1 < sizeof(sCeSelfReplacement.name) && name[i]; ++i)
+            sCeSelfReplacement.name[i] = name[i];
+    }
+    sCeSelfReplacement.name[i] = '\0';
+    sCeSelfReplacement.script.SetReader(script);
+    sCeSelfReplacement.owner.SetReader(script->mDefaultThing);
+    sCeSelfReplacement.vm = &MISSION_SCRIPT_VM;
+    sCeSelfReplacement.pending = true;
+    return true;
+}
+
+// Called immediately after each instruction, before the VM reads its code again. This ends the old
+// execution, clears its stack and only then lets SetScript delete the old script and install its successor.
+bool PortCeCompleteSelfReplacement(CVM *vm)
+{
+    if (!sCeSelfReplacement.pending || sCeSelfReplacement.vm != vm)
+        return false;
+    IScript *old = sCeSelfReplacement.script.ToRead();
+    CComplexThing *owner = sCeSelfReplacement.owner.ToRead();
+    char name[sizeof(sCeSelfReplacement.name)];
+    size_t i = 0;
+    for (; i + 1 < sizeof(name) && sCeSelfReplacement.name[i]; ++i)
+        name[i] = sCeSelfReplacement.name[i];
+    name[i] = '\0';
+    sCeSelfReplacement.name[0] = '\0';
+    sCeSelfReplacement.script.SetReader(NULL);
+    sCeSelfReplacement.owner.SetReader(NULL);
+    sCeSelfReplacement.pending = false;
+    sCeSelfReplacement.vm = NULL;
+    vm->mStack.Clear();
+    vm->mRunning = FALSE;
+    vm->mCode = NULL;
+    if (owner && old && owner->GetMissionScript() == old)
+        owner->SetScript(name);
+    return true;
+}
+#endif
+
 

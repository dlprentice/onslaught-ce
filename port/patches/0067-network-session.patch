+// The fixed session bridge lives beside the real callers. It does not create actors or mission events.
+class CENetworkSession
+{
+public:
+    static void PreRun() { GAME.PreRun(); }
+    static int QuitCode() { return GAME.mQuit; }
+    static void RebaseRenderClock()
+    {
+        GAME.mBaseTime = PLATFORM.GetSysTimeFloat();
+        GAME.mFrameTime = GAME.mFrameTime2 = GAME.mBaseTime;
+        GAME.CalcRenderFrameFraction();
+    }
+    static int AbortLoad()
+    {
+        EQuitType quit = GAME.mQuit == QT_NONE ? QT_LOAD_ERROR : GAME.mQuit;
+        quit = (EQuitType)CE_SessionBeginTeardown(quit);
+        GAME.SetQuit(quit);
+        for (int i = 0; i < MAX_PLAYERS; ++i)
+        {
+            SAFE_DELETE(GAME.mPlayer[i]);
+            SAFE_DELETE(GAME.mCurrentCamera[i]);
+        }
+        return quit;
+    }
+};
+extern "C" void CE_SessionGamePreRun() { CENetworkSession::PreRun(); }
+extern "C" int CE_SessionGamePump()
+{
+    // The normal platform loop blocks on GetMessage while inactive. A load/start barrier must retain its own
+    // monotonic deadline even when minimized, so only drain a bounded batch of this window's queued messages.
+    MSG message;
+    for (unsigned budget = 0; budget < 64 && PeekMessage(&message, NULL, 0U, 0U, PM_REMOVE); ++budget)
+    {
+        if (message.message == WM_QUIT) { GAME.SetQuit(QT_QUIT_TO_SYSTEM); return 1; }
+        TranslateMessage(&message);
+        DispatchMessage(&message);
+    }
+    if (LT.WantsToQuit()) { GAME.SetQuit(QT_QUIT_TO_SYSTEM); return 1; }
+    return 0;
+}
+extern "C" void CE_SessionGameIdle() { Sleep(1); }
+extern "C" int CE_SessionGameQuitCode() { return CENetworkSession::QuitCode(); }
+extern "C" void CE_SessionGameSetQuit(int quit) { GAME.SetQuit((EQuitType)quit); }
+extern "C" uint32_t CE_SessionGameTick() { return EVENT_MANAGER.GetFrameCount(); }
+extern "C" void CE_SessionGameRebaseRenderClock() { CENetworkSession::RebaseRenderClock(); }
+extern "C" int CE_SessionGameAbortLoad() { return CENetworkSession::AbortLoad(); }
+#endif

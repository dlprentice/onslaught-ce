+// Worker-only observation of accepted refill wakes. An anomaly says nothing about audible output; event coalescing
+// and bounded logs mean absence cannot rule out missed wakes. The CE stream guard owns this state.
+static void PortRefillOrder(DWORD offset)
+{
+    if (!sPortRefillDiagnostics || !sPortRefillOrderKnown) return;
+    unsigned half = offset / STREAM_HALF;
+    if (half == sPortRefillExpectedHalf) { sPortRefillExpectedHalf ^= 1u; return; }
+    sPortRefillOrderKnown = false;
+    if (sPortRefillOrderLines >= 8u) return; // bounded for the process as well as once per playback epoch
+    ++sPortRefillOrderLines;
+    PortSessionLog(PORT_SESSION_MUSIC, false,
+        "refill order anomaly expected_half=%u handled_half=%u (handled wakes only; audible output unknown)",
+        sPortRefillExpectedHalf, half);
 }

 #include	"mouse.h"
 #include	"Credits.h"
 #include	"tweak.h"
+
+#ifdef CE_VERSION
+// patch 0199 (port/game/ce_museum.h): during a visit the gallery reads a picture, a model or a movie as viewable, whatever the career holds, and shows no level;
+// it starts no other load and writes no unlock.
+extern "C" bool PortCeMuseumActive(void);
+extern "C" void PortCeMuseumEnd(void);
+extern "C" bool PortCeMuseumCanLoad(bool visual);
+extern "C" bool PortCeMuseumCanChangeUnlocks(void);
+extern "C" int PortCeMuseumReadUnlock(int ordinary, bool visual, int viewed, int unavailable);
+static EGoodieType get_goodie_type_hack(SINT goodie_num);
+
+// What a visitor reads over a cell of the wall, in place of "Unlocked!" (a visitor has unlocked nothing, and says nothing of it): a picture, a model or a movie is
+// named for what it is. title is the line above, body the one under it; it already holds the exhibit's own title for the first 78, and for the concept art and
+// the film clips, which the original gave no title, it says what they are.
+static void ce_museum_words(SINT goodie_num, WCHAR *title, WCHAR *body)
+{
+	const EGoodieType type = (goodie_num >= 0 && goodie_num < MAX_NUM_GOODIES) ? get_goodie_type_hack(goodie_num) : GT_LEVEL;
+	if (type == GT_MESH)
+		wcscpy(title, ToWCHAR("Model"));
+	else if (type == GT_FMV)
+		wcscpy(title, ToWCHAR("Movie"));
+	else if (type == GT_IMAGE)
+		wcscpy(title, ToWCHAR("Picture"));
+	else
+	{
+		wcscpy(title, ToWCHAR(""));
+		wcscpy(body, ToWCHAR(""));
+		return;
+	}
+	if (goodie_num >= 78 && type == GT_IMAGE)
+		wcscpy(body, ToWCHAR("Concept art"));
+	else if (goodie_num >= 201 && type == GT_FMV)
+	{
+		char text[32];
+		sprintf(text, "Cutscene %d", (int)(goodie_num == 232 ? 33 : goodie_num - 200));
+		wcscpy(body, ToWCHAR(text));
+	}
+}
+
+static EGoodieState ce_museum_visual_state(SINT goodie_num)
+{
+	if (goodie_num < 0 || goodie_num >= MAX_NUM_GOODIES)
+		return GS_UNKNOWN;
+	const EGoodieType type = get_goodie_type_hack(goodie_num);
+	return (EGoodieState)PortCeMuseumReadUnlock(GS_UNKNOWN, type == GT_IMAGE || type == GT_MESH || type == GT_FMV, GS_OLD, GS_UNKNOWN);
+}
+#endif
+

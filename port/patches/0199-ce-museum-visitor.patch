 void	CFrontEnd::SetPage(EFrontEndPage page, SINT time)	// FUNCTION: 0x00466ae0
 {
 #ifdef CE_VERSION
+	// patch 0199: admit a visitor redirect only for a real, existing requested page; any other request ends the visit and goes on
+	// through the original path unchanged. The gallery's Back asks for the save page, which saves the career on the way out; a
+	// visitor goes back to the CE page instead, as the CE page opens from the main menu, and nothing is saved.
+	if (PortCeMuseumActive())
+	{
+		const unsigned pageCount = sizeof(mPages) / sizeof(mPages[0]);
+		if (((unsigned)page >= pageCount) || (mPages[page] == 0))
+			PortCeMuseumEnd();
+		else
+		{
+			const EFrontEndPage asked = page;
+			page = (EFrontEndPage)PortCeMuseumPage(mActivePage, page, FEP_LANGUAGE_TEST, FEP_GOODIES, FEP_SAVEGAME);
+			if (page != asked)
+				time = 70;
+		}
+	}
+#endif
+#ifdef CE_VERSION
 	PortSessionLog(PORT_SESSION_GAME, false, "frontend page=%d requested=%d transition_ticks=%d", (int)mActivePage, (int)page, time);
 #endif
 	// Shouldn't happen...

+						ceLabel[ceRows] = TEXT_DB.GetString(ACCURACY);
+						sprintf(ceValue[ceRows++],"%.2f%%",((float) p->GetStat(PS_ROUNDSHIT)*100.0f) / ((float) p->GetStat(PS_ROUNDSFIRED)));

+				if (p && PortCeDebriefStatsOn(!IsMultiplayer() && GetNPlayers() == 1))
+				{
+					WCHAR			*ceLabel[CE_DEBRIEF_MAX_ROWS];
+					char			ceValue[CE_DEBRIEF_MAX_ROWS][32];
+					CeDebriefPanel	cePanel;
+					int				ceRows = 0;
+					ceLabel[ceRows] = TEXT_DB.GetString(TOTAL_MISSION_TIME);
+					sprintf(ceValue[ceRows++],"%.2fs",((float) p->GetStat(PS_TIMEASJET)+p->GetStat(PS_TIMEASWALKER))/20.0f);

 		if (mTypeHeap[aType] == &mSoundHeap  ) CONSOLE.FatalError(FALSE, 0xd0, -1);
 	}
 
+#ifndef CE_NETWORK_OFF
+	if (data && CE_LockstepRequested())
+	{
+		// the whole payload the heap handed out: a tiny cell in full (16 bytes, even for a request of none), else the block's own size, which is the request rounded up to 16
+		// or a little more when its block was not split
+		UINT	lClear = (aSize + 0xf) & 0xfffffff0;
+		if (mDefaultHeap.IsTiny(data) || mThingHeap.IsTiny(data))
+			lClear = TINY_BLOCK;
+		else if (CMemoryBlock::GetBlock(data)->GetSize() > lClear)
+			lClear = CMemoryBlock::GetBlock(data)->GetSize();
+		memset(data, 0, lClear);	// port (lockstep co-op): a block starts as zeros on both peers, not as what the heap last held there (the draw loop allocates and frees on its own schedule)
+	}
+#endif
 	return data;
 }
 

+// Port (patch 0250): retail's own row orders for ori * point in the rubble spawns. CDestroyableSegment::SpawnRubble
+// (004430d8..00443141): row 0 (Y + Z) + X, rows 1 and 2 (X + Y) + Z. CDestroyableExtraUseMeshSegment::SpawnRubble
+// (00443b21..00443b76): every row (X + Y) + Z. maths.h sums (Z + Y) + X.
+static inline FVector SegmentRubbleRows(const FMatrix &m, const FVector &v)
+{
+	return FVector(((m.Row[0].Y * v.Y) + (m.Row[0].Z * v.Z)) + (m.Row[0].X * v.X),
+		((m.Row[1].X * v.X) + (m.Row[1].Y * v.Y)) + (m.Row[1].Z * v.Z),
+		((m.Row[2].X * v.X) + (m.Row[2].Y * v.Y)) + (m.Row[2].Z * v.Z));
+}
+static inline FVector SegmentRowsXYZ(const FMatrix &m, const FVector &v)
+{
+	return FVector(((m.Row[0].X * v.X) + (m.Row[0].Y * v.Y)) + (m.Row[0].Z * v.Z),
+		((m.Row[1].X * v.X) + (m.Row[1].Y * v.Y)) + (m.Row[1].Z * v.Z),
+		((m.Row[2].X * v.X) + (m.Row[2].Y * v.Y)) + (m.Row[2].Z * v.Z));
+}

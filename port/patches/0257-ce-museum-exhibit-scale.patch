+#ifdef CE_VERSION
+// Port (patch 0257): uniform world scale S shrinks inv1-transformed direction vectors (w == 0) by 1/S;
+// renormalize scaled directions to unit length while leaving unscaled vectors untouched.
+static inline void ce_normalize_dir3(D3DXVECTOR4 &v)
+{
+	const float lenSq = v.x * v.x + v.y * v.y + v.z * v.z;
+	if ((lenSq > 1e-12f) && ((lenSq < 0.9999f) || (lenSq > 1.0001f)))
+	{
+		const float invLen = 1.0f / sqrtf(lenSq);
+		v.x *= invLen;
+		v.y *= invLen;
+		v.z *= invLen;
+	}
+}
+#endif
